# Required: posting key for the 3Speak service Hive account (must be set at deploy time)
THREESPEAK_POSTING_WIF=
THREESPEAK_HIVE_ACCOUNT=badadib
SERVER_PORT=4020

# ManteAuth integration (used by /api/manteauth/exchange)
MANTEAUTH_URL=https://auth.okinoko.io
MANTEAUTH_CLIENT_ID=threespeak
MANTEAUTH_CLIENT_SECRET=

# --- Community translation editor (/translate, server/i18n-editor.cjs) ---
# Comma-separated Hive usernames allowed to edit translations (case-insensitive).
# Empty or unset = editor disabled: every write is refused and /api/i18n/me
# reports translator:false for everyone. Read at startup (restart to change).
TRANSLATORS=
# Where edits are stored. Mongo is used when a URI is set AND the `mongodb` driver
# is installed in server/ (it is NOT a dependency today); otherwise JSON files
# under I18N_DATA_DIR (default server/data/i18n, gitignored).
I18N_MONGODB_URI=
I18N_DATABASE_NAME=
I18N_DATA_DIR=
# Mirror the edits into one pull request. A fine-grained PAT limited to ONE
# repository with "Contents: read and write" + "Pull requests: read and write".
# Unset = no PR sync (edits still go live through the overlay).
# Set it on ONE server only (prod): each server rebuilds the branch from its own
# overlay, so two servers would keep overwriting each other's PR.
GITHUB_TRANSLATIONS_TOKEN=
# owner/repo the PR goes to (default Mantequilla-Soft/new-3speak-tv)
GITHUB_TRANSLATIONS_REPO=
# Base branch the PR targets (default develop)
GITHUB_TRANSLATIONS_BASE=
# Branch rebuilt from the base on every sync (default community-translations)
GITHUB_TRANSLATIONS_BRANCH=
