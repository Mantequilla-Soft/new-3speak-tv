# ===========================================
# 3Speak New Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!

# ===========================================
# REQUIRED - Core API Configuration
# ===========================================

# Main 3Speak API endpoint (Western server)
VITE_API_URL_FROM_WEST=

# Video CDN domain for streaming
VITE_APP_VIDEO_CDN_DOMAIN=

# Pancreas API URL (for sitemaps and SEO)
VITE_PANCREAS_API_URL=https://tags.3speak.tv

# Legacy API URL
VITE_LEGACY_API_URL=https://legacy.3speak.tv

# ===========================================
# REQUIRED - SEO Configuration
# ===========================================

# Site base URL (used in meta tags, sitemaps, structured data)
VITE_SITE_URL=https://3speak.tv

# ===========================================
# REQUIRED - Upload Configuration
# ===========================================

# Authentication token for video uploads
VITE_UPLOAD_TOKEN=

# Upload endpoint URL
VITE_UPLOAD_URL=

# ===========================================
# Video Player Configuration
# ===========================================

# Video player base URL (for iframe embed)
# Use http://localhost:3005 for local development
# Use https://play.3speak.tv for production
VITE_PLAYER_URL=

# ===========================================
# Playlists API Configuration
# ===========================================

# Playlists API endpoint
# Default: https://3speak-playlists.okinoko.io/api
VITE_PLAYLISTS_API_URL=

# ===========================================
# Feed & Checker API Configuration
# ===========================================

# 3Speak feed API endpoint (legacy)
VITE_FEED_URL=

# 3Speak Checker API base URL (views, my-videos, feeds, shorts, trending, etc.)
# Default: https://checker.3speak.tv
VITE_CHECKER_URL=

# 3Speak tag feed URL (legacy)
VITE_THREESPEAK_TAG_FEED_URL=

# ===========================================
# Hive RPC API Configuration
# ===========================================

# Hive RPC API endpoint (primary node) — first candidate the healthy-node
# probe tries, and the seed value used before the probe resolves.
# Default: https://api.hive.blog
VITE_HIVE_API_URL=

# Comma- or whitespace-separated fallback Hive RPC nodes. Probed alongside
# the primary; the first one to answer is pinned for the session. Override
# this to add/remove nodes without touching the source.
# Default: https://api.deathwing.me,https://api.openhive.network,https://techcoderx.com
VITE_HIVE_API_FALLBACKS=

# Required Resource Credits (raw RC units) before an upload is allowed — the
# pre-flight gate blocks publishing when the user has less. Leave unset to
# estimate it live from the chain (~2.2B). Pin it to a number to override.
# NOTE: must stay well under the ~4.88B new-account RC grant or it false-blocks
# low-Hive-Power users (a real post costs ~1.8B).
VITE_POST_RC_COST=2200000000

# ===========================================
# 3Speak Embed Upload (for video reactions)
# ===========================================

# Embed upload endpoint (TUS)
VITE_EMBED_UPLOAD_URL=

# Embed API base URL (for thumbnail etc.)
VITE_EMBED_API_URL=

# Optional pool of embed-upload server BASE hosts (no /uploads), comma- or
# space-separated. When set (2+), the uploader picks the least-busy reachable one
# per upload and sticks to it for the whole upload. Each host MUST share the same
# MongoDB + EMBED_API_KEY. Leave empty to use the single VITE_EMBED_API_URL host.
# To enable load-aware picking, have each server's GET /health return
# { activeUploads, freeDiskPct } — otherwise selection falls back to latency.
# e.g. https://embed2.3speak.tv,https://embed3.3speak.tv,https://embed4.3speak.tv
VITE_EMBED_UPLOAD_URLS=

# Embed API key (get from 3Speak team)
VITE_EMBED_API_KEY=

# ===========================================
# 3Speak Video Editor
# ===========================================

# Video editor iframe URLs (comma-separated, a random working one will be picked)
# Use http://localhost:9091 for local development
# Use https://editor.3speak.tv for production
VITE_EDITOR_URLS=

# ===========================================
# Feature Flags
# ===========================================

# Show editor features: Remix and Clip buttons (true/false)
VITE_FEATURE_EDITOR=true

# Compact sidebar: groups feed links into a "Feeds" dropdown
# and app store links into a "Native Apps" dropdown (true/false)
VITE_COMPACT_SIDEBAR=true

# ===========================================
# Translation API Configuration
# ===========================================

# LibreTranslate API endpoint
# Use http://localhost:5000 for local development
# Use https://3speak-translator.okinoko.io for production
VITE_TRANSLATE_API_URL=

# ===========================================
# Watch History
# ===========================================

# Days to keep watch history (default: 14)
VITE_WATCH_HISTORY_THRESHOLD_DAYS=14

# ===========================================
# HiveSigner Configuration
# ===========================================

# HiveSigner app account name
VITE_HIVESIGNER_APP=threespeak

# ===========================================
# 3Speak Image Upload Service (thumbnails)
# ===========================================

# Image upload service base URL
# In dev: use /image-api to proxy through Vite (avoids CORS)
# In production: use https://images.3speak.tv directly
VITE_IMAGE_UPLOAD_URL=/image-api

# Image upload service API key (Bearer token)
VITE_IMAGE_UPLOAD_KEY=

# ==========================================
# Reporting API
# ==========================================
VITE_REPORT_API_SECRET=
VITE_REPORT_API_URL=

# ===========================================
# MetaMask Snap Login (Hive via MetaMask)
# ===========================================

# Enable MetaMask Snap as a login provider (true/false)
# WARNING: Enabling this triggers a "Which extension?" popup for users
# who have both Phantom and MetaMask installed. Only enable for
# testnet/development or when MetaMask login is explicitly needed.
VITE_ENABLE_METAMASK_SNAP=false

# ===========================================
# 3Speak Pro Subscriptions (VSC/Magi)
# ===========================================

# Enable the 3Speak Pro subscription section in the wallet page (true/false)
VITE_ENABLE_SUBS=false

# Show the "Try 3Speak Pro free for 24h" trial button in the wallet
# panel (true/false). Each Hive account can claim the trial once in
# its lifetime — enforced server-side via the embed-users.testing_started
# field. Requires the hangouts-api to be deployed with
# ENABLE_PRO_TESTING=true.
VITE_ENABLE_PRO_TESTING=false

# VSC network: 'testnet' or 'mainnet'
VITE_VSC_NETWORK=mainnet

# ==========================================
# Social verifier (mantequilla-social-verifier)
# Verifies ownership of web2 social-media accounts (YouTube, ...) via md5 challenge.
# See: https://3speak-verify.okinoko.io
# ==========================================
VITE_SOCIAL_VERIFIER_URL=

# ==========================================
# 3Speak Audio API (used by the audio upload modal)
# Mirrors snapie-io's NEXT_PUBLIC_3SPEAK_API_KEY contract.
# ==========================================
VITE_3SPEAK_AUDIO_API_URL=https://audio.3speak.tv
VITE_3SPEAK_API_KEY=
# Account that receives 100% beneficiaries for "pay-per-listen" audio uploads.
VITE_PPL_BENEFICIARY=threespeak-audio
# Optional: obfuscate audio listen heartbeats (must match checker
# LISTEN_BEAT_KEY). Empty = plaintext beats.
VITE_LISTEN_BEAT_KEY=

# ==========================================
# OpenPods / Hangouts API (Snapie hangouts service)
# When unset, OpenPods features (sidebar link badge, live strip, lobby, modal)
# fall back to no-op clients and don't fire any requests.
# ==========================================
VITE_HANGOUTS_API_URL=

# LiveKit websocket URL used by the OpenPods modal. Has a built-in
# fallback to wss://livekit.3speak.tv, so safe to leave blank in prod.
VITE_LIVEKIT_URL=wss://livekit.3speak.tv

# Bearer token forwarded to <HangoutsProvider imageServerApiKey>. Enables
# the background-image picker in the OpenPods Create-Room dialog. Same
# upload backend as VITE_IMAGE_UPLOAD_KEY but consumed by the SDK.
# Leave blank to hide the picker.
VITE_IMAGE_SERVER_API_KEY=

# Where to persist the hangouts session JWT across reloads:
#   none    — re-sign on every visit (default; safest)
#   session — sessionStorage; survives reloads in the same tab
#   local   — localStorage; survives full browser restarts (XSS-readable
#             for up to the JWT TTL — only enable on trusted devices)
VITE_HANGOUTS_TOKEN_STORAGE=none

# VSC smart contract id that backs the 3Speak Pro subscription panel.
# Required when VITE_ENABLE_SUBS=true. Different on testnet vs mainnet.
VITE_VSC_SUBS_CONTRACT_ID=

# ==========================================
# Debug flags
# ==========================================

# Set to "true" to log embed-upload progress + payloads to the browser
# console. Off in production.
VITE_EMBED_DEBUG=false

# ==========================================
# Butrauth (ManteAuth) login provider
# Set to "false" to hide the butrauth login button and skip the manteauth
# flow entirely. Default: enabled when unset.
# ==========================================
VITE_ENABLE_BUTRAUTH=true

# Bearer key for checker PUT /video/thumbnail (= checker API_SECRET_KEY)
VITE_CHECKER_API_KEY=

# Pay-per-listen controls in audio uploader (false = hidden/disabled)
VITE_ENABLE_PPL=true

# OpenPods deployments — comma-separated "apiBase|livekitWsUrl" pairs.
VITE_HANGOUTS_API_URLS=https://hangouts.okinoko.io|wss://livekit.okinoko.io

# Mobile-only front-camera recorder + voice teleprompter (prototype). Off by default.
VITE_ENABLE_CAMERA_RECORD=false

# Teleprompter self-hosted STT WebSocket (empty = Web Speech only)
VITE_STT_WS_URL=

# Every checker instance (comma-separated). The app races GET /health/latency on
# each and sends checker calls to the fastest for the viewer; VITE_CHECKER_URL is
# always a candidate and the fallback. Empty = one instance.
VITE_CHECKER_URLS=https://checker.3speak.tv,https://checker-us.3speak.tv
# Extra Mongo round trips a feed makes beyond the probe (weights db_ms). Default 2.
# VITE_CHECKER_DB_WEIGHT=2
